{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "*": ["./*"],
      "#shared/*.js": ["../shared/*.ts"],
      "#shared/*.mjs": ["../shared/*.mts"]
    },
    "typeRoots": ["../types"],
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "../shared/**/*"
  ]
}
