{
  "name": "agentwfy-app",
  "productName": "AgentWFY",
  "version": "2.1.1",
  "description": "AI agent desktop app with local SQLite database",
  "type": "module",
  "main": "dist/desktop/main.js",
  "imports": {
    "#shared/*.js": {
      "types": "./shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#shared/*.mjs": {
      "types": "./shared/*.mts",
      "default": "./dist/shared/*.mjs"
    }
  },
  "scripts": {
    "setup": "node scripts/setup",
    "build": "node scripts/build",
    "start": "node scripts/start",
    "dev": "node scripts/build && node scripts/start",
    "package": "node scripts/build && node scripts/package",
    "make": "node scripts/make"
  },
  "keywords": [],
  "author": {
    "name": "endenwer",
    "email": "endenwer@gmail.com"
  },
  "license": "MIT"
}
