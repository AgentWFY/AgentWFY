{
  "name": "agentwfy-app",
  "productName": "AgentWFY",
  "version": "2.1.1",
  "description": "AI agent desktop app with local SQLite database",
  "type": "module",
  "main": "dist/desktop/main.js",
  "imports": {
    "#shared/*.js": {
      "types": "./shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#shared/*.mjs": {
      "types": "./shared/*.mts",
      "default": "./dist/shared/*.mjs"
    }
  },
  "scripts": {
    "setup": "node scripts/setup",
    "build": "node scripts/build",
    "build-desktop": "node scripts/build-desktop",
    "build-mobile": "node scripts/build-mobile",
    "build-server": "node scripts/build-server",
    "start": "node scripts/start",
    "dev": "node scripts/build-desktop && node scripts/start",
    "package": "node scripts/build-desktop && node scripts/package",
    "make": "node scripts/make",
    "preview": "node scripts/preview",
    "record-demo": "scripts/record-demo",
    "mobile-device-run": "scripts/mobile-device-run",
    "mobile-run": "scripts/mobile-run",
    "mobile-tauri": "scripts/mobile-tauri",
    "mobile-doctor": "scripts/mobile-doctor"
  },
  "keywords": [],
  "author": {
    "name": "endenwer",
    "email": "endenwer@gmail.com"
  },
  "license": "MIT"
}
