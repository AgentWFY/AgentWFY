#!/usr/bin/env node
import { execSync } from 'child_process'
import { cpSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'fs'
import { dirname, join } from 'path'
import { fileURLToPath } from 'url'
import { ensureVendor } from './lib/ensure-vendor.mjs'
import { inlinePreload } from './lib/inline-preload.mjs'
import { generateSystemConfigKeys } from './lib/generate-system-config-keys.mjs'

const __dirname = dirname(fileURLToPath(import.meta.url))
const root = join(__dirname, '..')

const startedAt = Date.now()

ensureVendor(root)
const desktop = join(root, 'desktop')
const mobile = join(root, 'mobile')
const shared = join(root, 'shared')
const dist = join(root, 'dist')
const distDesktop = join(dist, 'desktop')
const distMobile = join(dist, 'mobile')
const distShared = join(dist, 'shared')

rmSync(dist, { recursive: true, force: true })

// ── Static assets ──

mkdirSync(join(distDesktop, 'renderer'), { recursive: true })
cpSync(join(desktop, 'renderer', 'index.html'), join(distDesktop, 'renderer', 'index.html'))
cpSync(join(desktop, 'renderer', 'global.css'), join(distDesktop, 'renderer', 'global.css'))
cpSync(join(desktop, 'command_palette.html'), join(distDesktop, 'command_palette.html'))
cpSync(join(desktop, 'confirmation.html'), join(distDesktop, 'confirmation.html'))
mkdirSync(join(distMobile, 'src'), { recursive: true })
cpSync(join(mobile, 'index.html'), join(distMobile, 'index.html'))
cpSync(join(mobile, 'src', 'styles.css'), join(distMobile, 'src', 'styles.css'))
mkdirSync(join(dist, 'icons'), { recursive: true })
cpSync(join(root, 'icons', 'icon.png'), join(dist, 'icons', 'icon.png'))
cpSync(join(root, 'icons', 'icon.png'), join(dist, 'icon.png'))

// ── System data ──

// Docs
const docsDir = join(desktop, 'system-docs')
const docFiles = readdirSync(docsDir).filter(f => f.endsWith('.md')).sort()
const docs = docFiles.map(f => ({ name: f.replace(/\.md$/, ''), content: readFileSync(join(docsDir, f), 'utf-8') }))
mkdirSync(distShared, { recursive: true })
writeFileSync(join(distShared, 'system-docs.json'), JSON.stringify(docs))

// Views
const viewsDir = join(desktop, 'system-views')
const viewFiles = readdirSync(viewsDir).filter(f => f.endsWith('.html')).sort()
const views = viewFiles.map(f => {
  const content = readFileSync(join(viewsDir, f), 'utf-8')
  const name = f.replace(/\.html$/, '')
  const titleMatch = content.match(/<title>([^<]+)<\/title>/i)
  const title = titleMatch ? titleMatch[1].trim() : name.split('.').pop().charAt(0).toUpperCase() + name.split('.').pop().slice(1)
  return { name, title, content }
})
writeFileSync(join(distShared, 'system-views.json'), JSON.stringify(views))

// Config
const configData = readFileSync(join(shared, 'system-config', 'system-config.json'), 'utf-8')
const configItems = JSON.parse(configData)
writeFileSync(join(distShared, 'system-config.json'), JSON.stringify(configItems))

// Generate src/system-config/keys.ts from system-config.json (typed constants
// for use across main + renderer). Must run before tsgo so the compiler sees
// any updates.
generateSystemConfigKeys(shared)

// ── TypeScript compilation ──

const tsgo = join(root, 'vendor', 'tsgo', 'lib', process.platform === 'win32' ? 'tsgo.exe' : 'tsgo')
execSync(`"${tsgo}"`, { cwd: root, stdio: 'inherit' })

// The renderer is served via the `app://` protocol rooted at dist/desktop/renderer/.
// It uses an import map for #shared/*, so mirror the compiled shared package
// under that protocol root. The mobile webview is served by Tauri rooted at
// dist/mobile/ and uses the same import map; mirror shared/ there too.
cpSync(join(dist, 'shared'), join(distDesktop, 'renderer', 'shared'), { recursive: true })
cpSync(join(dist, 'shared'), join(distMobile, 'shared'), { recursive: true })

// ── Preload bundling ──

inlinePreload(distDesktop)

// ── Remote daemon ──

// Preview and local development should be able to launch the daemon from the
// same freshly-built tree as the Electron app.
execSync(`node "${join(root, 'remote-backend-server', 'scripts', 'build.mjs')}"`, {
  cwd: root,
  stdio: 'inherit',
})

function countJs(dir) {
  let n = 0
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.isDirectory()) n += countJs(join(dir, entry.name))
    else if (entry.name.endsWith('.js') || entry.name.endsWith('.cjs')) n += 1
  }
  return n
}
const elapsed = ((Date.now() - startedAt) / 1000).toFixed(1)
console.log(`Build OK · ${countJs(dist)} files · ${elapsed}s`)
