#!/usr/bin/env node
// Build everything — desktop + mobile + remote-backend-server.
//
// Use this when you're not sure which hosts a change touches, or when you've
// edited shared/. For host-specific work, prefer the narrower scripts —
// they're faster and document intent:
//   ./scripts/build-desktop      ← edited only desktop/
//   ./scripts/build-mobile       ← edited only mobile/
//   ./scripts/build-server       ← edited only remote-backend-server/

import { execSync } from 'node:child_process'
import { rmSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const root = join(__dirname, '..')

const startedAt = Date.now()

// Per-host scripts only nuke their own subtree; nuke dist/ here so a full
// build also drops anything orphaned by deleted sources.
rmSync(join(root, 'dist'), { recursive: true, force: true })

for (const script of ['build-desktop', 'build-mobile', 'build-server']) {
  execSync(`node "${join(__dirname, script)}"`, { cwd: root, stdio: 'inherit' })
}

const elapsed = ((Date.now() - startedAt) / 1000).toFixed(1)
console.log(`build OK · ${elapsed}s total`)
