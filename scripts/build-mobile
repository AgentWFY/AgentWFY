#!/usr/bin/env node
// Build the mobile host: tsgo on mobile/ + shared/, plus mobile static
// assets and the shared-mirror inside the Tauri-served root.
//
// Use when you've edited only mobile/ (or shared/ and want mobile ready).
// For everything in one shot, use `scripts/build`.

import { execSync } from 'child_process'
import { cpSync, mkdirSync, rmSync } from 'fs'
import { dirname, join } from 'path'
import { fileURLToPath } from 'url'
import { ensureVendor } from './lib/ensure-vendor.mjs'
import { generateSystemConfigKeys } from './lib/generate-system-config-keys.mjs'

const __dirname = dirname(fileURLToPath(import.meta.url))
const root = join(__dirname, '..')

const startedAt = Date.now()

ensureVendor(root)
const mobile = join(root, 'mobile')
const shared = join(root, 'shared')
const dist = join(root, 'dist')
const distMobile = join(dist, 'mobile')
const distShared = join(dist, 'shared')

rmSync(distMobile, { recursive: true, force: true })

// ── Static assets ──

mkdirSync(join(distMobile, 'src'), { recursive: true })
cpSync(join(mobile, 'index.html'), join(distMobile, 'index.html'))
cpSync(join(mobile, 'src', 'styles.css'), join(distMobile, 'src', 'styles.css'))

// Codegen the typed constants from system-config.json. Idempotent; safe to
// run from desktop and mobile builds independently.
generateSystemConfigKeys(shared)

// ── TypeScript compilation ──

const tsgo = join(root, 'vendor', 'tsgo', 'lib', process.platform === 'win32' ? 'tsgo.exe' : 'tsgo')
execSync(`"${tsgo}" --project "${join(mobile, 'tsconfig.json')}"`, { cwd: root, stdio: 'inherit' })

// The Tauri webview loads from dist/mobile/ and uses an import map for
// #shared/* — mirror the compiled shared package under that root.
mkdirSync(distShared, { recursive: true })
cpSync(distShared, join(distMobile, 'shared'), { recursive: true })

const elapsed = ((Date.now() - startedAt) / 1000).toFixed(1)
console.log(`build-mobile OK · ${elapsed}s`)
