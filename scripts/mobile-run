#!/usr/bin/env bash
# Build the mobile frontend (via the root build, which also covers desktop
# + shared), then invoke tauri with the passed args.
#
# Examples:
#   ./scripts/mobile-run dev
#   ./scripts/mobile-run build
#   ./scripts/mobile-run ios dev
#   ./scripts/mobile-run ios dev "iPhone 16 Pro"
#   ./scripts/mobile-run android init
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

node "$SCRIPT_DIR/build"
exec "$SCRIPT_DIR/mobile-tauri" "$@"
