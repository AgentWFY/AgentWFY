#!/usr/bin/env node
// Build the remote-backend-server using tsgo from vendor/. The daemon stays
// free of external npm deps; we reuse the binary scripts/setup already
// downloads.

import { execSync } from 'node:child_process'
import { rmSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { ensureVendor } from './lib/ensure-vendor.mjs'
import { generateSystemConfigKeys } from './lib/generate-system-config-keys.mjs'
import { generateViewBootstrap } from './lib/generate-view-bootstrap.mjs'
import { writeSystemAssets } from './lib/write-system-assets.mjs'

const __dirname = dirname(fileURLToPath(import.meta.url))
const projectRoot = join(__dirname, '..')
const serverRoot = join(projectRoot, 'remote-backend-server')
const shared = join(projectRoot, 'shared')

const tsgo = join(
  projectRoot,
  'vendor',
  'tsgo',
  'lib',
  process.platform === 'win32' ? 'tsgo.exe' : 'tsgo',
)

const dist = join(serverRoot, 'dist')
rmSync(dist, { recursive: true, force: true })

ensureVendor(projectRoot)
generateSystemConfigKeys(shared)
generateViewBootstrap(shared)

execSync(`"${tsgo}" --project "${join(serverRoot, 'tsconfig.json')}"`, {
  cwd: serverRoot,
  stdio: 'inherit',
})

// AgentDb resolves system data JSON files via `import.meta.dirname/../*.json`.
// In the daemon's compiled tree, db/agent-db.js lives at dist/shared/db/, so
// the JSONs must be at dist/shared/. Generate them from source here so this
// per-host build produces a runnable daemon from a clean checkout.
writeSystemAssets(projectRoot, join(dist, 'shared'))

console.log('agentwfy-remote-server: build OK')
