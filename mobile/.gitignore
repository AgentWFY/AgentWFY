# Tauri / Rust
src-tauri/target
src-tauri/gen/schemas

# Tauri iOS — Rust→Obj-C FFI header regenerated by cargo build
src-tauri/gen/apple/Sources/*/bindings/

# Tauri iOS — CocoaPods working copy (Podfile.lock IS committed)
src-tauri/gen/apple/Pods/

# Xcode noise (xcuserdata/, build/, Externals/ are covered by
# src-tauri/gen/apple/.gitignore from `tauri ios init`)
*.xcuserstate
.swiftpm/
*.ipa
*.dSYM
*.dSYM.zip

# Tauri Android (most of these come from `tauri android init`)
src-tauri/gen/android/.gradle
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea/
src-tauri/gen/android/captures/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
