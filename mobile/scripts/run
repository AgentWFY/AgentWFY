#!/usr/bin/env bash
# Build the mobile frontend (via the root build, which also covers desktop
# + shared), then invoke tauri with the passed args.
#
# Examples:
#   ./mobile/scripts/run dev
#   ./mobile/scripts/run build
#   ./mobile/scripts/run ios dev
#   ./mobile/scripts/run ios dev "iPhone 16 Pro"
#   ./mobile/scripts/run android init
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

node "$ROOT/scripts/build"
exec "$SCRIPT_DIR/tauri" "$@"
