{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "*": ["./*"],
      "#shared/*.js": ["./shared/*.ts"],
      "#shared/*.mjs": ["./shared/*.mts"]
    },
    "typeRoots": ["types"]
  },
  "include": [
    "desktop/**/*",
    "mobile/**/*",
    "shared/**/*",
    "types/**/*"
  ]
}
